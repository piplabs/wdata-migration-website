# Deployer private key (no 0x prefix required; keep this secret, never commit the real .env)
PRIVATE_KEY=

# Owner of the deployed migration contract (receives Ownable2Step ownership).
OWNER_ADDRESS=

# Token addresses. On BSC mainnet these default to the verified addresses in the deploy
# script, so they only need to be set for testnet (or to override).
WIP_ADDRESS=
WDATAIP_ADDRESS=

# RPC endpoints
BSC_RPC=https://bsc-dataseed.bnbchain.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# BscScan API key for contract verification (--verify)
BSCSCAN_API_KEY=
