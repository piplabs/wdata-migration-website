# WalletConnect / RainbowKit project id (required) — https://cloud.reown.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# --- Data Network (Story) mainnet, chain 1514 ---
# WIP is the native-token wrapper predeploy; WDATA is the Create3 deployment.
NEXT_PUBLIC_DATA_RPC_URL=https://mainnet.datarpc.io
NEXT_PUBLIC_DATA_WIP_ADDRESS=0x1514000000000000000000000000000000000000
NEXT_PUBLIC_DATA_WDATA_ADDRESS=0xD18a56346227f25D1410F98f78234305660bB877

# --- Aeneid testnet, chain 1315 ---
NEXT_PUBLIC_AENEID_RPC_URL=https://aeneid.datarpc.io
NEXT_PUBLIC_AENEID_WIP_ADDRESS=0x1514000000000000000000000000000000000000
NEXT_PUBLIC_AENEID_WDATA_ADDRESS=0xD18a56346227f25D1410F98f78234305660bB877

# --- BNB Smart Chain mainnet, chain 56 ---
# WdataipMigration must be deployed and pre-funded with WDATAIP. Leave blank to disable BSC swaps.
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_BSC_WIP_ADDRESS=0x4d6394bC3031F751EdcE368C189b0E060b527107
NEXT_PUBLIC_BSC_WDATAIP_ADDRESS=0xA37EDed373c5cdF88644db7C6b89f222e756aFB2
NEXT_PUBLIC_BSC_MIGRATION_ADDRESS=

# --- BNB Smart Chain testnet, chain 97 (optional) ---
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
NEXT_PUBLIC_BSC_TESTNET_WIP_ADDRESS=
NEXT_PUBLIC_BSC_TESTNET_WDATAIP_ADDRESS=
NEXT_PUBLIC_BSC_TESTNET_MIGRATION_ADDRESS=
